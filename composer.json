{
    "name": "samuel-olavo/laravel-xen-orchestra",
    "description": "Laravel integration for the Xen Orchestra REST API: fluent access to virtual machines, hosts, pools, storage repositories and asynchronous tasks.",
    "keywords": ["laravel", "xen-orchestra", "xcp-ng", "xenserver", "virtualization", "api-client", "xoa"],
    "homepage": "https://github.com/samuel-olavo/laravel-xen-orchestra",
    "license": "MIT",
    "authors": [
        {
            "name": "Samuel Olavo",
            "email": "samuelolavo@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/samuel-olavo/laravel-xen-orchestra/issues",
        "source": "https://github.com/samuel-olavo/laravel-xen-orchestra"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "friendsofphp/php-cs-fixer": "^3.50"
    },
    "autoload": {
        "psr-4": {
            "SamuelOlavo\\XenOrchestra\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SamuelOlavo\\XenOrchestra\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SamuelOlavo\\XenOrchestra\\Laravel\\XenOrchestraServiceProvider"
            ],
            "aliases": {
                "Xo": "SamuelOlavo\\XenOrchestra\\Laravel\\Facades\\Xo"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
